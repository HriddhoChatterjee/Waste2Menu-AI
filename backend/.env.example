# KitchenOS Environment Variables Configuration
# ===============================================

# App Metadata
APP_NAME="KitchenOS - Scrap-to-Menu AI & NGO Redistribution System"
APP_VERSION="1.0.0"
DEBUG=false

# Database Connection (SQLite for Zero-Setup Local Dev, PostgreSQL for Production)
# Local SQLite:
DATABASE_URL=sqlite:///./kitchenos.db

# Production PostgreSQL Example:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/kitchenos

# Restaurant Geospatial Coordinates (Central Kitchen)
RESTAURANT_LATITUDE=28.6139
RESTAURANT_LONGITUDE=77.2090

# CORS Whitelist (JSON Array of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","*"]

# Security & Tokens
SECRET_KEY="kitchenos-production-super-secret-key-change-in-production"
OTP_EXPIRY_MINUTES=60

# Business & Optimization Constants
MIN_BATCH_PORTIONS=8
MIN_GROSS_MARGIN_PCT=85.0
CO2E_PER_KG_SCRAP=2.5
