# PostgreSQL Connection (Default pgAdmin 4 local database):
# Replace 'your_password' with your PostgreSQL superuser password
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/waste2menu

# If you prefer running with SQLite (Zero setup fallback):
# DATABASE_URL=sqlite:///./waste2menu.db

# Server port and host
PORT=8000
HOST=0.0.0.0
